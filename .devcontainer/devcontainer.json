{
  "name": "opencode-cursor-plugin",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteEnv": {
    "CURSOR_API_KEY": "${localEnv:CURSOR_API_KEY}"
  },
  "postCreateCommand": "node -e \"const [major]=process.versions.node.split('.') ; if (Number(major) < 20) { console.error('Node.js 20+ is required'); process.exit(1); }\" && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "typescript.tsdk": "node_modules/typescript/lib",
        "[javascript]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[typescript]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[json]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "biomejs.biome"
        }
      }
    }
  }
}
